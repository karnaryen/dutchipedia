{
  "name": "dutchipedia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream --filter './apps/*' dev",
    "build": "pnpm --recursive --filter './apps/*' build",
    "start": "pnpm --recursive --parallel --stream --filter './apps/*' start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:types": "pnpm --recursive --filter './apps/*' --filter './packages/*' lint:types",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.1"
}
